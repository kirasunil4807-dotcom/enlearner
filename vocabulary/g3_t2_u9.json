[{"word":"season","translation":"季节"},{"word":"It's warm and rainy.","translation":"又热又下雨"},{"word":"We can plant trees.","translation":"我们可以种树"},{"word":"What season is it?","translation":"什么季节"},{"word":"Is it spring?","translation":"是春天吗？"},{"word":"The leaves are yellow and red.","translation":"叶子黄又红"},{"word":"No, it's autumn.","translation":"不这是秋天"},{"word":"have a picnic","translation":"野餐"},{"word":"ice-skate","translation":"溜冰"},{"word":"ski","translation":"滑雪"},{"word":"We can swim and make sandcastles there.","translation":"我们可以在那里游泳做沙堡"},{"word":"We can have picnics in the park","translation":"我们可以在公园里野餐"},{"word":"We have hats, gloves and scarves.","translation":"我们有帽子手套和围巾"},{"word":"We can ice-skate.","translation":"我们可以溜冰"},{"word":"Spring is warm","translation":"春天是温暖的"},{"word":"Summer is hot","translation":"夏天是热的"},{"word":"Autumn is cool.","translation":"秋天是凉的"},{"word":"Winter is cold","translation":"冬天是冷的"},{"word":"A bird is flying slowly.","translation":"一只鸟在慢慢飞"}]
